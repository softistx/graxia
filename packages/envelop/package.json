{
	"name": "@graxia/envelop",
	"version": "0.1.0",
	"description": "Run Envelop plugins inside graxia with one adapter",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"graphql",
		"envelop",
		"bun"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/graxia.git",
		"directory": "packages/envelop"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test --pass-with-no-tests src",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@envelop/core": "6.0.1",
		"@envelop/depth-limit": "8.0.1",
		"@envelop/generic-auth": "12.0.1",
		"@envelop/persisted-operations": "11.0.1",
		"@envelop/response-cache": "10.0.1",
		"@graphql-hive/logger": "1.2.0",
		"@graxia/core": "workspace:^",
		"@types/bun": "^1.4.4",
		"graphql": "17.1.0"
	},
	"peerDependencies": {
		"@envelop/core": "^5.6.1 || ^6.0.1",
		"@graxia/core": "workspace:^",
		"graphql": "^17.1.0",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"bun": ">=1.4.4"
	}
}
