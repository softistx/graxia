{
	"name": "@graxia/mcp",
	"version": "0.1.3",
	"description": "Model Context Protocol server over graxia: stateless Streamable HTTP with graphql_schema, graphql_query and graphql_mutate tools, and persisted operations as typed tools",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"graphql",
		"mcp",
		"ai",
		"bun"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/graxia.git",
		"directory": "packages/mcp"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test --pass-with-no-tests src",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@types/bun": "^1.4.5",
		"@graxia/core": "workspace:^",
		"@modelcontextprotocol/client": "~2.4.0",
		"graphql": "^17.1.0"
	},
	"peerDependencies": {
		"@graxia/core": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0",
		"graphql": "^17.1.0"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "~2.4.0",
		"zod": "^4.2.0"
	},
	"sideEffects": false,
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"bun": ">=1.4.4"
	}
}
