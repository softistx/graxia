{
	"name": "@graxia/core",
	"version": "0.0.0",
	"private": true,
	"description": "The Bun-native GraphQL server engine: typed plugins, graphql 17, GraphQL over HTTP, SSE, WebSocket, trusted documents, OpenTelemetry",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js",
			"default": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"graphql",
		"server",
		"bun",
		"plugins",
		"sse",
		"websocket",
		"graphql-ws"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/graxia.git",
		"directory": "packages/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test --pass-with-no-tests src",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/testing/index.ts"
		]
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"graphql": "17.1.0",
		"graphql-http": "1.23.1"
	},
	"peerDependencies": {
		"graphql": "^17.0.0",
		"typescript": "^6.0.3 || ^7.0.0"
	}
}
