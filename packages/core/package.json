{
	"name": "@graxia/core",
	"version": "0.3.0",
	"description": "The Bun-native GraphQL server engine: typed plugins, graphql 17, GraphQL over HTTP, error masking, subscriptions over SSE and WebSocket, @defer and @stream, a typed PubSub, in-process execute and a test client",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js",
			"default": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"graphql",
		"server",
		"bun",
		"plugins",
		"graphql-http",
		"graphql-over-http",
		"graphql-server",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/graxia.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/softistx/graxia/tree/develop/packages/core#readme",
	"bugs": {
		"url": "https://github.com/softistx/graxia/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test --pass-with-no-tests src",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/testing/index.ts"
		]
	},
	"devDependencies": {
		"@opentelemetry/api": "1.10.0",
		"@opentelemetry/sdk-trace": "3.1.1",
		"@types/bun": "^1.4.4",
		"graphql": "17.1.0",
		"graphql-http": "1.23.1",
		"graphql-ws": "^6.4.3",
		"meros": "^1.3.2"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1",
		"graphql": "^17.1.0",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"peerDependenciesMeta": {
		"@opentelemetry/api": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	}
}
