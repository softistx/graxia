{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src"],
	"exclude": [
		"node_modules",
		"dist",
		"test",
		"**/*.spec.ts",
		"src/schema/codegen-fixture",
		"src/parity",
		"**/*.test.ts",
		"**/*.test-util.ts",
		"**/*.test-d.ts"
	]
}
