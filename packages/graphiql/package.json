{
	"name": "@softistx/graxia-graphiql",
	"version": "0.2.8",
	"description": "GraphiQL 4 for graxia, bundled for a strict CSP (no CDN, no external URL)",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"graphql",
		"graphiql",
		"bun",
		"csp"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/graxia.git",
		"directory": "packages/graphiql"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts && bun run scripts/build-assets.ts",
		"test": "bun test --pass-with-no-tests src",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@graphiql/toolkit": "^1.0.1",
		"@softistx/graxia": "workspace:^",
		"@types/bun": "^1.4.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"graphiql": "4.1.2",
		"graphql": "^17",
		"graphql-ws": "^6.4.3",
		"react": "19",
		"react-dom": "19"
	},
	"peerDependencies": {
		"@softistx/graxia": "workspace:^",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"sideEffects": false,
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"bun": ">=1.4.4"
	}
}
