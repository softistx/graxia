{
	"name": "@graxia/redis",
	"version": "0.1.1",
	"description": "Redis PubSub, cache and field rate limit adapters for graxia, on @softistx/redis",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"graphql",
		"redis",
		"pubsub",
		"bun"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/graxia.git",
		"directory": "packages/redis"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test --pass-with-no-tests src",
		"typecheck": "bun check"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@graxia/core": "workspace:^",
		"@softistx/redis": "^0.23.0",
		"@types/bun": "^1.4.4"
	},
	"peerDependencies": {
		"@graxia/core": "workspace:^",
		"@softistx/redis": ">=0.22.0 <1",
		"typescript": "^6.0.3 || ^7.0.0"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
