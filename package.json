{
	"name": "graxia",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"build": "bun run scripts/workspace.ts build",
		"typecheck": "bun check && bun run typecheck:scripts",
		"typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
		"test": "bun run scripts/workspace.ts test && bun test ./scripts/",
		"lint": "biome ci",
		"fix": "biome check --write",
		"format": "biome format",
		"changeset": "changeset",
		"changeset:version": "changeset version && bun install --lockfile-only",
		"changeset:publish": "bun run build && bun run verify:artifacts && changeset publish",
		"changeset:status": "changeset status --since=${CHANGESET_BASE:-origin/develop}",
		"verify:artifacts": "bun run scripts/verify-artifacts.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.1",
		"@types/bun": "^1.4.4",
		"graphql-sse": "^2.6.3",
		"typescript": "~6.0.3"
	},
	"overrides": {
		"typescript": "~6.0.3"
	},
	"packageManager": "bun@1.4.4"
}
